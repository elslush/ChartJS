<?xml version="1.0" encoding="utf-8" ?>
<widget id="ChartJS.widgets.GanttChart.widget.GanttChart" needsEntityContext="true" xmlns="http://www.mendix.com/widget/1.0/">
    <name>ChartJS - Gantt Chart</name>
    <description>ChartJS Library wrapper - Gantt Chart (simulated via stacked horizontal bars)</description>
    <icon>
        
    </icon>
    <properties>
        <!-- Appearance -->
        <property key="width" type="integer" required="true" defaultValue="600">
            <caption>Width</caption>
            <category>Appearance</category>
            <description>Initial width of the chart canvas</description>
        </property>
        <property key="height" type="integer" required="true" defaultValue="300">
            <caption>Height</caption>
            <category>Appearance</category>
            <description>Initial height of the chart canvas</description>
        </property>
        <property key="responsiveRatio" type="integer" required="true" defaultValue="0">
            <caption>Responsive w/h ratio (%)</caption>
            <category>Appearance</category>
            <description>Responsive width height ratio</description>
        </property>
        <property key="xLabel" type="string" required="false" defaultValue="Day">
            <caption>X-axis label</caption>
            <category>Appearance</category>
            <description>Label to show on the X-axis (time axis). Default is 'Day'</description>
        </property>
        <property key="chartTitle" type="string" required="false" defaultValue="">
            <caption>Title</caption>
            <category>Appearance</category>
            <description>The title of the chart. Leave empty for no title</description>
        </property>
        <property key="titleSize" type="integer" required="true" defaultValue="12">
            <caption>Title font-size</caption>
            <category>Appearance</category>
            <description>The size of the chart title. Default is 12</description>
        </property>
        <property key="labelFont" type="string" required="true" defaultValue="Helvetica Neue">
            <caption>Font</caption>
            <category>Appearance</category>
            <description>Font used in the chart. Default (or empty) = Helvetica Neue</description>
        </property>
        <!-- Animation -->
        <property key="responsiveAnimationDuration" type="integer" required="true" defaultValue="1000">
            <caption>Responsive animation duration</caption>
            <category>Animation</category>
            <description>Animation duration (milliseconds) for responsive resizing</description>
        </property>
        <property key="chartAnimation" type="boolean" required="true" defaultValue="true">
            <caption>Animation</caption>
            <category>Animation</category>
            <description>Switch animation on and off</description>
        </property>
        <property key="animationDuration" type="integer" required="true" defaultValue="1000">
            <caption>Animation duration</caption>
            <category>Animation</category>
            <description>Animation duration (milliseconds) for rendering</description>
        </property>
        <property key="animationEasing" type="enumeration" required="true" defaultValue="easeOutQuart">
            <caption>Animation easing</caption>
            <category>Animation</category>
            <description>Animation easing function</description>
            <enumerationValues>
                <enumerationValue key="linear">linear</enumerationValue>
                <enumerationValue key="easeInQuad">easeInQuad</enumerationValue>
                <enumerationValue key="easeOutQuad">easeOutQuad</enumerationValue>
                <enumerationValue key="easeInOutQuad">easeInOutQuad</enumerationValue>
                <enumerationValue key="easeOutQuart">easeOutQuart</enumerationValue>
                <enumerationValue key="easeOutBounce">easeOutBounce</enumerationValue>
            </enumerationValues>
        </property>
        <!-- Data Source -->
        <property key="sourceentity" type="entity" required="true" allowNonPersistableEntities="true">
            <caption>Chart Entity</caption>
            <category>Data Source</category>
            <description>Container entity, referencing Task entity objects via reference set.</description>
        </property>
        <property key="datasourcemf" type="microflow" required="false">
            <caption>Microflow</caption>
            <category>Data Source</category>
            <description>Microflow returning a 'Chart Entity' object.</description>
            <returnType type="Object" entityProperty="sourceentity"></returnType>
        </property>
        <!-- Task (Data Set) -->
        <property key="datasetentity" type="entity" required="true" allowNonPersistableEntities="true" entityProperty="sourceentity" isPath="yes" pathType="referenceSet">
            <caption>Task Entity</caption>
            <category>Task</category>
            <description>Entity representing a task/bar in the Gantt chart</description>
        </property>
        <property key="datasetsorting" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>Sorting</caption>
            <category>Task</category>
            <description>Attribute used for sorting task objects</description>
            <attributeTypes>
                <attributeType name="AutoNumber"/>
                <attributeType name="Currency"/>
                <attributeType name="DateTime"/>
                <attributeType name="Float"/>
                <attributeType name="Integer"/>
                <attributeType name="Long"/>
                <attributeType name="Decimal"/>
            </attributeTypes>
        </property>
        <property key="datasetlabel" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>Task label (for legend)</caption>
            <category>Task</category>
            <description>Label used internally (required by Core)</description>
            <attributeTypes>
                <attributeType name="Enum"/>
                <attributeType name="String"/>
            </attributeTypes>
        </property>
        <property key="taskLabel" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>Task name</caption>
            <category>Task</category>
            <description>Task name shown on Y-axis</description>
            <attributeTypes>
                <attributeType name="Enum"/>
                <attributeType name="String"/>
            </attributeTypes>
        </property>
        <property key="taskStart" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>Start day</caption>
            <category>Task</category>
            <description>Start day number for the task</description>
            <attributeTypes>
                <attributeType name="AutoNumber"/>
                <attributeType name="Currency"/>
                <attributeType name="Float"/>
                <attributeType name="Integer"/>
                <attributeType name="Long"/>
                <attributeType name="Decimal"/>
            </attributeTypes>
        </property>
        <property key="taskEnd" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>End day</caption>
            <category>Task</category>
            <description>End day number for the task</description>
            <attributeTypes>
                <attributeType name="AutoNumber"/>
                <attributeType name="Currency"/>
                <attributeType name="Float"/>
                <attributeType name="Integer"/>
                <attributeType name="Long"/>
                <attributeType name="Decimal"/>
            </attributeTypes>
        </property>
        <property key="seriescolor" type="attribute" entityProperty="datasetentity" allowNonPersistableEntities="true" required="true">
            <caption>Bar color (in Hex)</caption>
            <category>Task</category>
            <description>Color of the task bar</description>
            <attributeTypes>
                <attributeType name="Enum"/>
                <attributeType name="String"/>
            </attributeTypes>
        </property>
        <property key="maxDays" type="integer" required="false" defaultValue="0">
            <caption>Max days (X-axis)</caption>
            <category>Task</category>
            <description>Maximum value for the X-axis. Set to 0 for auto-scaling</description>
        </property>
        <!-- Behaviour -->
        <property key="onclickmf" type="microflow" required="false">
            <caption>On Click Microflow</caption>
            <category>Behavior</category>
            <description>Microflow to invoke when chart canvas is clicked</description>
            <returnType type="Void"></returnType>
        </property>
        <property key="onclickDataSetMf" type="microflow" required="false" entityProperty="datasetentity">
            <caption>On Click Task Microflow</caption>
            <category>Behavior</category>
            <description>Microflow to invoke when a task bar is clicked, passing the Task entity</description>
            <returnType type="Void"></returnType>
        </property>
        <property key="onDestroyMf" type="microflow" required="false" entityProperty="sourceentity">
            <caption>On Destroy Microflow</caption>
            <category>Behavior</category>
            <description>Microflow to be called when the widget is destroyed</description>
            <returnType type="Void"></returnType>
        </property>
        <property key="base64Attr" type="attribute" required="false">
            <caption>Base 64 Attribute</caption>
            <category>Behavior</category>
            <description>The attribute to store the base64 encoding of the chart when rendered.</description>
            <attributeTypes>
                <attributeType name="String"/>
            </attributeTypes>
        </property>
        <!-- Settings -->
        <property key="responsive" type="boolean" required="true" defaultValue="true">
            <caption>Responsive</caption>
            <category>Appearance</category>
            <description>Chart canvas dimensions respond to changes in layout</description>
        </property>
        <property key="scaleGridLineColor" type="string" required="true" defaultValue="rgba(0,0,0,.05)">
            <caption>Grid line color</caption>
            <category>Settings</category>
            <description>Color of the grid lines (rgba)</description>
        </property>
        <property key="showTooltips" type="boolean" required="true" defaultValue="true">
            <caption>Show tooltip</caption>
            <category>Settings</category>
            <description>Determines whether to draw tooltips on the canvas or not</description>
        </property>
        <property key="maintainAspectRatio" type="boolean" required="true" defaultValue="false">
            <caption>Maintain aspect ratio</caption>
            <category>Settings</category>
            <description>Maintain the aspect ratio?</description>
        </property>
    </properties>
</widget>
